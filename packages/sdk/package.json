{
  "name": "@lusorbe/sdk",
  "version": "0.1.0",
  "description": "SDK oficial da API da Lusorbe para TypeScript e JavaScript (browser e Node).",
  "license": "UNLICENSED",
  "private": true,
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "generate": "openapi-typescript openapi.json -o src/generated/schema.ts",
    "check:generated": "openapi-typescript openapi.json -o src/generated/schema.ts --check",
    "typecheck": "tsc --noEmit",
    "build": "tsc -p tsconfig.build.json",
    "test": "node --experimental-strip-types --test test/*.test.ts"
  },
  "devDependencies": {
    "@types/node": "24.13.3",
    "openapi-typescript": "7.13.0",
    "typescript": "~6.0.3"
  }
}