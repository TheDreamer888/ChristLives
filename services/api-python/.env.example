# Copia para .env (nunca faças commit do .env) e preenche.
# Gera segredos com:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"   # SESSION_ENC_KEY

# --- Ambiente -----------------------------------------------------------------
ENV=production
PUBLIC_FRONTEND_URL=https://app.exemplo.pt
PUBLIC_API_URL=https://api.exemplo.pt
CORS_ORIGINS=https://app.exemplo.pt
SECRET_KEY=

# --- Sessões (obrigatórios) -------------------------------------------------------
SESSION_JWT_SECRET=
SESSION_ENC_KEY=
AUTH_ENUM_SECRET=

# --- Passkeys (WebAuthn) ----------------------------------------------------------
WEBAUTHN_RP_ID=app.exemplo.pt
WEBAUTHN_ORIGIN=https://app.exemplo.pt

# --- Dados (obrigatórios em produção) ------------------------------------------------
# Com o docker-compose.yml, DATABASE_URL e REDIS_URL são montados automaticamente.
DATABASE_URL=postgresql://lusorbe:SENHA@host:5432/lusorbe
REDIS_URL=redis://:SENHA@host:6379/0

# --- Administração --------------------------------------------------------------------
AUDIT_HMAC_KEY=
ADMIN_BOOTSTRAP_EMAILS=
ADMIN_IP_ALLOWLIST=
# AUDIT_LOG_PATH=/var/log/lusorbe/audit.jsonl

# --- Login social (preenche só os que usares) -----------------------------------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITLAB_CLIENT_ID=
GITLAB_CLIENT_SECRET=
APPLE_CLIENT_ID=
APPLE_CLIENT_SECRET=
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

# Assistente (Claude). Sem chave, o assistente fica desligado (503) e o resto funciona.
# A chave fica só no servidor; nunca no frontend.
ANTHROPIC_API_KEY=
ASSISTANT_ENABLED=true
ASSISTANT_DAILY_LIMIT=30
ASSISTANT_MODEL=claude-opus-5-5
ASSISTANT_EFFORT=medium
# Esforço da habilidade de matemática (raciocínio adaptativo)
ASSISTANT_MATH_EFFORT=high
