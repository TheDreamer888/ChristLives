{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentParameters.json#",
  "contentVersion": "1.0.0.0",
  "parameters": {
    "location": {
      "value": "eastus"
    },
    "environment": {
      "value": "dev"
    },
    "appName": {
      "value": "aegis"
    },
    "frontendImage": {
      "value": "ghcr.io/your-org/aegis-frontend:latest"
    },
    "apiImage": {
      "value": "ghcr.io/your-org/aegis-api-python:latest"
    },
    "frontendOrigin": {
      "value": "https://app.example.com"
    },
    "apiOrigin": {
      "value": "https://api.example.com"
    }
  }
}
